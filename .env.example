# Application
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:4000
RP_NAME=RSVR Secure Access
# Must match the hostname in APP_ORIGIN (localhost for local development).
RP_ID=localhost

# Generate each with: openssl rand -hex 32
SESSION_SECRET=replace-with-64-hex-characters
OTP_PEPPER=replace-with-a-different-64-hex-characters
PII_ENCRYPTION_KEY=replace-with-a-third-64-hex-characters

# Email delivery (optional in local development; OTP is printed to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="RSVR Secure Access <no-reply@example.com>"

# SMS delivery through Twilio (optional in local development)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Never enable DEV_OTP outside local development.
DEV_OTP=true
